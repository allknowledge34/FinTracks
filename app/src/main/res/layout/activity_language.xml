<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"

    >


    <RelativeLayout
        android:id="@+id/rel_top"
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_margin="5dp"
            android:foreground="@drawable/ripple_effect"
            android:gravity="center"
            android:maxLines="1"
            android:padding="5dp"
            android:visibility="gone"
            android:src="@drawable/ic_back_arrow" />



        <TextView
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/img_back"
            android:layout_toStartOf="@+id/img_done"
            android:text="Language"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="21sp"
            >

        </TextView>


        <ImageView
            android:id="@+id/img_done"
            android:layout_width="50dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_done_24"
            android:foreground="@drawable/ripple_effect_rect"
            android:background="@drawable/bg_lang_done">

        </ImageView>


    </RelativeLayout>

    <FrameLayout
        android:layout_above="@+id/constrain_adview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3F4F8"
        android:layout_below="@+id/rel_top">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rev_langauge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="40dp">

        </androidx.recyclerview.widget.RecyclerView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</RelativeLayout>